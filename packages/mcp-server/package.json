{
  "name": "@griot/mcp-server",
  "version": "0.1.0",
  "description": "Griot core MCP server with Streamable HTTP transport and Bedrock integration",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
